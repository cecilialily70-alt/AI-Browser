# AI Browser 环境变量示例
# ---------------------------------------------------------------------------
# 用法：复制为 .env 并按需填写；或直接在启动前 export / $env: 设置。
# 本文件只收录「当前代码真实读取」的变量，已废弃或无效的配置项不会出现在这里。
# 完整的变量语义见 README.md「§16 环境变量」。
# ---------------------------------------------------------------------------

# ============================ 用户可设置项 ============================

# 日志级别。Rust 与 Node(Sidecar) 双侧生效；缺省 warn（仅输出 warn/error）。
# 取值：trace | debug | info | warn | error | off
TIANSHUTAI_LOG_LEVEL=warn

# 前端日志级别（仅 Vite 构建期可见）。缺省 info（静默 debug/trace）。
# 取值：trace | debug | info | warn | error
VITE_LOG_LEVEL=info

# Agent 技能包目录覆盖（绝对路径）。留空则使用内置 sidecar/agent_skills。
TIANSHUTAI_AGENT_SKILLS_DIR=

# 内核（Chromium 解包树）搜索根目录覆盖（绝对路径）。
TIANSHUTAI_BROWSE_ROOT=

# GPU 指纹模式覆盖。
TIANSHUTAI_GPU_MODE=

# 绑定指定 CDP target id（多标签页时锁定操作对象）。
TIANSHUTAI_CDP_TARGET_ID=

# ---------------------------------------------------------------------------
# AI Key 进程级兜底：仅当 SQLite 设置里未配置对应 Key 时生效。
# 优先级：ZAI_API_KEY → DEEPSEEK_API_KEY → OPENAI_API_KEY
# 均未命中时，AI 对话退化为本地离线回复；纯 RPA / 直接填表不受影响。
# ---------------------------------------------------------------------------
ZAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ===================== 上游内核契约变量（CLOAKBROWSER_*） =====================
# 说明：这些变量在运行时由本应用按需注入，通常无需手动设置。
# CLOAKBROWSER_LICENSE_KEY 亦可通过应用内「设置 → 浏览器 → 浏览器内核密钥」写入数据库。
CLOAKBROWSER_LICENSE_KEY=
# 以下三项由 Sidecar 在调用内核前自行注入 / 恢复，此处列出仅供排障参考：
# CLOAKBROWSER_BINARY_PATH=
# CLOAKBROWSER_CACHE_DIR=
# CLOAKBROWSER_RELEASE_CHANNEL=
# CLOAKBROWSER_VERSION=

# ===================== 由 Rust 自动注入（请勿手动设置） =====================
# 以下变量由宿主进程在拉起 Sidecar 时注入；手动设置会被覆盖，且可能造成鉴权失败。
# TIANSHUTAI_IPC_URL             本地上报服务地址 http://127.0.0.1:<随机端口>
# TIANSHUTAI_PROFILE_ID          当前环境 ID
# TIANSHUTAI_IPC_TOKEN           本地 IPC 会话令牌（缺失或不符返回 401）
# TIANSHUTAI_BROWSER_DOWNLOAD_DIR  常规浏览器下载根目录
# TIANSHUTAI_SCRAPER_DOWNLOAD_DIR  采集/媒体下载根目录

# ===================== 旧前缀兼容（无需设置） =====================
# 上述任一 TIANSHUTAI_<后缀> 未设置时，会回退读取 CLOAKFORGE_<同名后缀>
# （例如 CLOAKFORGE_LOG_LEVEL），以兼容改名前的既有脚本。

# ===================== 构建期变量（供打包脚本使用） =====================
# CARGO_TARGET_DIR  由 start-app.bat / build-app.bat 设置为 C:\temp\ai-browser-target
# NODE_OPTIONS      由 build-app.bat 设置为 --max-old-space-size=4096
