      "第二张", "第三张", "第四张", "第二张图", "第2张", "第3张", "前五张", "前5张",
      "第二个", "第三个", "第二个结果", "第2个", "第3个",
      "第一条结果", "打开第一条", "点开第一条", "前三条", "前3条", "前五条", "前5条", "前十条", "前10条",
      "翻页", "下一页", "下一张", "更多", "展开", "查看详情", "查看全部", "查看大图", "看大图",
      "收藏", "关注", "点赞", "评论", "分享", "转发", "加入购物车", "加购", "已加购", "结算页", "收银台", "已达收银台", "待支付", "下单", "购买",
      "填写", "填表", "填入", "输入并", "提交", "上传", "勾选", "选中", "选择", "切换语言",
      "download", "save as", "export", "click", "open the second", "switch to", "next page",
      "screenshot", "copy", "bookmark", "share", "add to cart", "checkout page", "awaiting payment", "fill in", "submit", "upload", "select"
    ]
  },
  "deliverableKinds": {
    "_comment": "任务契约用：把「一句话交付物」归到一种可验证的交付物类型（kind），供 core/deliverable_verify.ts 逐项核销。命中规则：取该句里出现的第一个 kind（priority 顺序），并把命中的词当线索。词条只描述通用动作语义，不含任何站点文案；缺这一节时契约退化为「只有 navigation/content_read」两种最粗类型。",
    "policy": {
      "_comment": "maxHints：单个交付物保留的线索词上限（防脏数据灌爆提示词）。priority 越靠前的 kind 越先被匹配到。",
      "maxHints": 6,
      "maxDeliverables": 8
    },
    "priority": [
      "download",
      "prepay_reached",
      "submitted",
      "choice_made",
      "field_filled",
      "content_read",
      "element_state",
      "answer_given",
      "navigation"
    ],
    "kinds": {
      "download": {
        "terms": ["下载", "另存为", "保存到", "保存为", "导出", "存图", "另存", "download", "save as", "save to", "export"],
        "required": true
      },
      "prepay_reached": {
        "_comment": "停在支付前：加购/收银台/待支付。优先于 submitted，避免「结算页」被「结算」收成已提交订单。不是已付款。",
        "terms": ["加购", "加入购物车", "加到购物车", "加进购物车", "已加购", "结算页", "收银台", "已达收银台", "待支付", "停在支付前", "add to cart", "checkout page", "stop before pay", "stop before payment", "awaiting payment"],
        "required": true
      },
      "submitted": {
