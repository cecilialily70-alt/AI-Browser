        "required": false
      },
      "element_state": {
        "terms": ["点击", "点开", "单击", "双击", "进入", "切换到", "切换", "跳转", "前往", "展开", "翻页", "下一", "查看", "click", "enter", "next page", "expand"],
        "required": true
      },
